diff --git a/studio/backend/tests/test_export_card_license.py b/studio/backend/tests/test_export_card_license.py
new file mode 100644
index 0000000..c615c93
--- /dev/null
+++ b/studio/backend/tests/test_export_card_license.py
@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from huggingface_hub import ModelCard
+
+EXPORT_PY = Path(__file__).resolve().parents[1] / "core/export/export.py"
+
+
+def _info(**card):
+    return SimpleNamespace(card_data = SimpleNamespace(**card))
+
+
+# Stand-in for the Hub, read through HfApi(token).model_info.
+HUB = {
+    "meta/llama": _info(license = "llama3.1"),
+    "unsloth/mirror": _info(license = "apache-2.0", base_model = "meta/original"),
+    "meta/original": _info(license = "other", license_name = "meta-community", license_link = "LICENSE"),
+}
+
+
+class FakeApi:
+    def __init__(self, token = None):
+        pass
+
+    def model_info(self, repo):
+        return HUB[repo]
+
+
+@pytest.fixture
+def lifted():
+    """export.py imports the whole backend; lift the card template and its license helper."""
+    tree = ast.parse(EXPORT_PY.read_text(encoding = "utf-8"))
+    nodes = [
+        node
+        for node in tree.body
+        if (isinstance(node, ast.FunctionDef) and node.name == "_base_model_license")
+        or (
+            isinstance(node, ast.Assign)
+            and any(isinstance(t, ast.Name) and t.id == "MODEL_CARD" for t in node.targets)
+        )
+    ]
+    assert len(nodes) == 2
+    env = {"HfApi": FakeApi}
+    exec(compile(ast.fix_missing_locations(ast.Module(body = nodes, type_ignores = [])), str(EXPORT_PY), "exec"), env)
+    return env
+
+
+def test_export_card_carries_the_base_model_license(lifted):
+    content = lifted["MODEL_CARD"].format(
+        username = "owner",
+        base_model = "meta/llama",
+        license = lifted["_base_model_license"]("meta/llama"),
+        model_type = "llama",
+        method = "finetuned",
+        extra = "unsloth",
+    )
+    assert ModelCard(content).data.license == "llama3.1"
+    assert "apache-2.0" not in content
+
+
+def test_export_card_follows_an_unsloth_mirror_to_its_original(lifted):
+    assert lifted["_base_model_license"]("unsloth/mirror").splitlines() == [
+        "license: other",
+        "license_name: meta-community",
+        "license_link: LICENSE",
+    ]
+
+
+def test_export_card_license_is_other_when_unreadable(lifted):
+    assert lifted["_base_model_license"]("local/path-that-is-not-on-the-hub") == "license: other"
