 # Both llama.cpp spellings: the Hub filters on the exact string, and upstream's add_tags is a no-op.
+def _base_model_license(base_model, token = None):
+    """YAML license lines for an export's card, taken from the model it derives from.
+
+    Same rule as unsloth.save._base_model_license: Unsloth mirrors are followed to the original
+    they declare, `license: other` keeps its license_name and license_link, and a license that
+    can't be read gives `other`, never apache-2.0.
+    """
+    try:
+        repo = base_model
+        for _ in range(5):
+            card = HfApi(token = token).model_info(repo).card_data
+            parent = getattr(card, "base_model", None) if card is not None else None
+            if isinstance(parent, list):
+                parent = parent[0] if parent else None
+            if repo.lower().startswith("unsloth/") and isinstance(parent, str) and parent:
+                repo = parent
+                continue
+            license = getattr(card, "license", None) if card is not None else None
+            if isinstance(license, str) and license:
+                lines = "license: " + license
+                if license == "other":
+                    for field in ("license_name", "license_link"):
+                        value = getattr(card, field, None)
+                        if isinstance(value, str) and value:
+                            lines += "\n" + field + ": " + value
+                return lines
+            break
+    except Exception:
+        pass
+    return "license: other"
+
+
